Port 22
ListenAddress 0.0.0.0
HostKey /home/git/.ssh/ssh_host_rsa_key
HostKey /home/git/.ssh/ssh_host_ecdsa_key
HostKey /home/git/.ssh/ssh_host_ed25519_key

PermitRootLogin no
PasswordAuthentication no
PubkeyAuthentication yes
ChallengeResponseAuthentication no
UsePAM yes
# The user's authorized_keys is a read-only bind mount owned by the host
# user (see docker-compose.yml), not by the git account, so sshd's default
# strict ownership/mode check would reject every key.
StrictModes no

AllowUsers git

X11Forwarding no
PrintMotd no
